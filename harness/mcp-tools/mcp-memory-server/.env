# ─────────────────────────────────────────────────────────────────────────────
# MCP Memory Server — environment variables
#
# Copy this file to .env and fill in the values you need.
# The server defaults to local SQLite + local filesystem when nothing is set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data backend ─────────────────────────────────────────────────────────────
# Options: sqlite (default) | supabase
DATA_BACKEND=supabase

# SQLite: path to the database file (default: ~/.mcp-memory/data.db)
# SQLITE_PATH=/absolute/path/to/data.db

# Supabase (only needed when DATA_BACKEND=supabase)
SUPABASE_URL=https://mnpezjcwavddiaxabwnf.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1ucGV6amN3YXZkZGlheGFid25mIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjA3MTkwMCwiZXhwIjoyMTAxNjQ3OTAwfQ.qENJTt79bMbKVjJ4wVmA59VYhlJ3_5LeGs2gmt25vu0

# ── Blob / file backend ───────────────────────────────────────────────────────
# Options: local (default) | s3
BLOB_BACKEND=s3

# Local FS: directory to store uploaded files (default: ~/.mcp-memory/files)
# LOCAL_STORAGE_PATH=/absolute/path/to/file/storage

# S3-compatible storage (only needed when BLOB_BACKEND=s3)
# Works with AWS S3, Cloudflare R2, Backblaze B2, Supabase Storage, MinIO, etc.
S3_BUCKET=mcp-memory-bucket
S3_REGION=auto
S3_ACCESS_KEY_ID=juqg5k6flqgk6cbtcmtienbh2mga
S3_SECRET_ACCESS_KEY=jzuqotuhrou562hclv32enknn3zak7so746fykrzwg67hwire5vlu
S3_ENDPOINT=https://gateway.storjshare.io
S3_FORCE_PATH_STYLE=false       # Set to "true" for MinIO

# ── Cloudflare R2 example ─────────────────────────────────────────────────────
# S3_BUCKET=my-memory-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-r2-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── Backblaze B2 example ──────────────────────────────────────────────────────
# S3_BUCKET=my-memory-bucket
# S3_REGION=us-west-004           # match your bucket region
# S3_ACCESS_KEY_ID=your-b2-key-id
# S3_SECRET_ACCESS_KEY=your-b2-application-key
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ── MinIO example ─────────────────────────────────────────────────────────────
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# ── Server transport ──────────────────────────────────────────────────────────
# Options: stdio (default — used by all MCP clients) | http
MCP_TRANSPORT=stdio
# MCP_PORT=3210   # Port to use when MCP_TRANSPORT=http

# ── Security ──────────────────────────────────────────────────────────────────
# Set to true to disable all mutation tools (db_insert, db_update, etc.)
READ_ONLY=false

# Enable write/delete audit log (SQLite backend only)
AUDIT_LOG=true
