# ── GitHub credentials ────────────────────────────────────────────────────────
GITHUB_TOKEN=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

# The GitHub owner (user or org) and repo that hosts the workflow files
GITHUB_OWNER=Godf-Cyb3r-1
GITHUB_REPO=TASK_RUNNER

# ── Guardrails ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed target URL prefixes / domains.
# generate_workflow will reject any targetUrl not matching one of these.
# Example: "https://mytarget.example.com,https://ctf.lab.internal"
SCOPE_ALLOWLIST=

# Max concurrent active workflow runs allowed at once (default 5)
MAX_CONCURRENT_RUNS=5

# Max number of parallel jobs per workflow plan (default 20, GitHub Free cap is 20)
MAX_JOBS_PER_PLAN=20

# Path for the local audit log (default: ./audit.log)
AUDIT_LOG_PATH=./audit.log

# ── Transport ────────────────────────────────────────────────────────────────
# "http"  → serve over HTTP/SSE (for Replit hosting or remote use)
# "stdio" → communicate over stdin/stdout (for local OpenCode use in WSL/Kali)
MCP_TRANSPORT=http

# HTTP port (only used when MCP_TRANSPORT=http)
PORT=3456

# Default branch to push workflow files to
GITHUB_DEFAULT_BRANCH=main
