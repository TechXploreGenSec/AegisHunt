# Bug-bounty runtime env — chmod 600, never commit. Generated from ~/.config/opencode/opencode.json + user-provided Neo4j Aura.
NEO4J_URI=REPLACE_ME__see_SECRETS.md
NEO4J_USER=REPLACE_ME__see_SECRETS.md
NEO4J_USERNAME=REPLACE_ME__see_SECRETS.md
NEO4J_PASSWORD=REPLACE_ME__see_SECRETS.md
NEO4J_DATABASE=REPLACE_ME__see_SECRETS.md
SUPABASE_URL=REPLACE_ME__see_SECRETS.md
SUPABASE_SERVICE_KEY=REPLACE_ME__see_SECRETS.md
S3_BUCKET=REPLACE_ME__see_SECRETS.md
S3_REGION=REPLACE_ME__see_SECRETS.md
S3_ENDPOINT=REPLACE_ME__see_SECRETS.md
S3_ACCESS_KEY_ID=REPLACE_ME__see_SECRETS.md
S3_SECRET_ACCESS_KEY=REPLACE_ME__see_SECRETS.md
SCOPE_DIR=$HOME/.config/opencode/scopes
METHODOLOGY_SOURCE_PATH=$HOME/hacktricks
# ACTION_RUNNER: set per engagement after scope_set writes scopes/<program>.json
# SCOPE_CONFIG_PATH=./scopes/<programId>.json
TELEGRAM_BOT_REPORT_TOKEN=REPLACE_ME__see_SECRETS.md
TELEGRAM_BOT_GENERAL_TOKEN=REPLACE_ME__see_SECRETS.md
TELEGRAM_BOT_APPROVE_TOKEN=REPLACE_ME__see_SECRETS.md
TELEGRAM_BOT_ASK_INPUT_TOKEN=REPLACE_ME__see_SECRETS.md
TELEGRAM_CHAT_ID=REPLACE_ME__see_SECRETS.md
